cabal-version:      2.4
name:               nl2proof
version:            0.1.0.0
synopsis:           Text to discrete logical form, with an explicit collapse step
description:
  Stage 1 of the text-to-logic pipeline described in ARCHITECTURE.md: a
  deterministic Montague/DRT core with provenance tagging throughout.
  .
  Dependencies are limited to what a bare GHC bindist ships with, so the
  project builds with plain @ghc --make@ and needs no package manager.
  See scripts/ for the no-cabal build path.

license:            NONE
author:             jmuslu
maintainer:         muslu.jo@northeastern.edu
category:           Language
build-type:         Simple
extra-doc-files:    README.md
                    ARCHITECTURE.md

common warnings
    ghc-options: -Wall -Wcompat -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wredundant-constraints

library
    import:           warnings
    hs-source-dirs:   src
    default-language: Haskell2010
    exposed-modules:  NL2Proof.Provenance
                      NL2Proof.Trace
                      NL2Proof.Semantics.Lambda
                      NL2Proof.Syntax.Category
                      NL2Proof.Syntax.Lexicon
                      NL2Proof.Syntax.Tokenize
                      NL2Proof.Syntax.CCG
                      NL2Proof.DRT.Types
                      NL2Proof.DRT.Build
                      NL2Proof.DRT.Canonical
                      NL2Proof.Collapse.Class
                      NL2Proof.Fragment
                      NL2Proof.Pipeline
                      NL2Proof.Stage2.Distribution
                      NL2Proof.Stage2.Modifier
                      NL2Proof.Stage2.Alternatives
                      NL2Proof.Stage2.Fingerprint
                      NL2Proof.Stage2.RSA
                      NL2Proof.Stage2.Pipeline
    build-depends:    base       >=4.14 && <5
                    , containers >=0.6  && <0.8

executable nl2proof-demo
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    default-language: Haskell2010
    build-depends:    base, nl2proof

test-suite nl2proof-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, nl2proof

test-suite nl2proof-stage2-test
    -- Stage 2 keeps its own suite so Stage 1's check count stays a stable
    -- number that means the same thing over time.
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Stage2Spec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof
