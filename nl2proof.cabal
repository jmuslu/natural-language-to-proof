cabal-version:      2.4
name:               nl2proof
version:            0.1.0.0
synopsis:           Deterministic NL to CCG to typed lambda to DRS, with provenance
description:
  A deterministic pipeline from natural language through CCG and typed lambda
  calculus to DRSs with provenance, feeding a derivation graph (Genealogy) with
  fusion and oracle-gated grounding. Truth enters only at the oracle.
  .
  Dependencies are limited to what a bare GHC bindist ships with, so the
  project builds with plain @ghc --make@ and needs no package manager.
  See scripts/ for the no-cabal build path.

license:            NONE
author:             jmuslu
maintainer:         muslu.jo@northeastern.edu
category:           Language
build-type:         Simple
extra-doc-files:    README.md
extra-source-files: scripts/check-oracle-boundary.sh
                    scripts/check-explain.sh
                    test/compile-fail/*.hs
                    test/compile-pass/*.hs

common warnings
    ghc-options: -Wall -Wcompat -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wredundant-constraints

library
    import:           warnings
    hs-source-dirs:   src
    default-language: Haskell2010
    exposed-modules:  NL2Proof.Provenance
                      NL2Proof.Trace
                      NL2Proof.Semantics.Lambda
                      NL2Proof.Semantics.Intensional
                      NL2Proof.Syntax.Category
                      NL2Proof.Syntax.Lexicon
                      NL2Proof.Syntax.Tokenize
                      NL2Proof.Syntax.CCG
                      NL2Proof.Syntax.CCGBank
                      NL2Proof.Syntax.CCGRules
                      NL2Proof.Syntax.CCGDeriv
                      NL2Proof.Syntax.CCGTypeChange
                      NL2Proof.Syntax.CCGParse
                      NL2Proof.Syntax.CCGSupertag
                      NL2Proof.Syntax.CCGLexicon
                      NL2Proof.Syntax.CCGSemParse
                      NL2Proof.Semantics.CCGSem
                      NL2Proof.DRT.Types
                      NL2Proof.DRT.Build
                      NL2Proof.DRT.Canonical
                      NL2Proof.Collapse.Class
                      NL2Proof.Fragment
                      NL2Proof.Pipeline
                      NL2Proof.Verify.Oracle
                      NL2Proof.Verify.ClaimKind
                      NL2Proof.Verify.Reported
                      NL2Proof.Verify.Claims
                      NL2Proof.Verify.External
                      NL2Proof.Genealogy
                      NL2Proof.Fusion
                      NL2Proof.Reward
                      NL2Proof.Bench.JSON
                      NL2Proof.Bench.ProofWriter
                      NL2Proof.Bench.Export
                      NL2Proof.Readings.Modifier
                      NL2Proof.Readings.Alternatives
                      NL2Proof.Discourse.SDRT
                      NL2Proof.Discourse.Threading
    build-depends:    base       >=4.14 && <5
                    , containers >=0.6  && <0.8

executable nl2proof-demo
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccgbank-report
    -- Runs the verified CCGbank category classifier over the real extracted
    -- lexicon (LEX/*.lexicon) and reports the representability split. A research
    -- driver, not part of the library or its test suites.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGBankReport.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccg-grammar-coverage
    -- Measures the combinatory rule set (CCGRules) against CCGbank's GRAMMAR
    -- file of attested parent-->children rule instances. External check on the
    -- rules and the feature-unification policy. Research driver.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGGrammarCoverage.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccg-reconstruct
    -- Runs the rule set over real .auto derivations and reports how many whole
    -- sentences reconstruct. Sentence-granularity external check behind Layer 2's
    -- test-case generator. Research driver; reads .auto paths from argv.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGReconstruct.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccg-lexicon-ingest
    -- Ingests the real CCGbank lexicon into provenance-tagged entries and reports
    -- the representable/unrepresentable/unparseable split, asserting every built
    -- skeleton is well-typed. Research driver.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGLexiconIngest.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccg-typechange-coverage
    -- Train/test measurement of the type-changing rule class: induce from train
    -- .auto files, measure held-out coverage on test files. Guards against
    -- corpus-memorisation by reporting generalisation, not in-sample fit.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGTypeChangeCoverage.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccg-parse-coverage
    -- Whole-sentence bottom-up parse coverage: folds combinators + the learned
    -- type-change inventory into one CKY parse and measures, on held-out test
    -- sentences given gold supertags, how often the grammar derives the gold root.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGParseCoverage.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccg-supertag-parse
    -- From-words parsing: a frequency supertagger (trained on the train split)
    -- offers each word its top-k categories, the chart combines them. Reports OOV,
    -- oracle inclusion@k (the ceiling), and from-words parse-to-gold-root coverage.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGSupertagParse.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

test-suite nl2proof-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

test-suite nl2proof-substrate-test
    -- Verification, genealogy, fusion and reward. Separate suite because these
    -- assert the design constraints (truth enters only at the oracle; a claim
    -- cannot ground itself) rather than the behaviour of the language front end.
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          SubstrateSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

test-suite nl2proof-ccgbank-test
    -- Parser and representability classifier for CCGbank's feature-annotated
    -- categories. Own suite so its check count is a stable, separate number
    -- from the Stage 1 language front end.
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          CCGBankSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable proofwriter-coverage
    -- ProofWriter (CWA/OWA depth-5) through the CCGbank parser and semantic
    -- layer: % parsed / typed / DRS / exactly matching the gold triples and
    -- rules, whole-theory match, failure buckets. Reads $PROOFWRITER_DIR and
    -- $CCGBANK_DIR (neither is in the repo). Research driver.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          ProofWriterCoverage.hs
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts "-with-rtsopts=-N"
    build-depends:    base, containers, nl2proof

test-suite nl2proof-ccgsem-test
    -- The CCGbank parser's semantic layer (closed-class entries, templates,
    -- combinator semantics, donkey binding, definites, ProofWriter conversion)
    -- on a miniature tag dictionary: needs no licensed data.
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          CCGSemSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable external-oracle
    import:           warnings
    hs-source-dirs:   tools
    main-is:          ExternalOracle.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

test-suite nl2proof-external-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          ExternalSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

test-suite nl2proof-readings-discourse-test
    -- Scope/coupling alternatives, modifier classes, SDRT and frontier-aware
    -- threading. Restored from tag pre-cut, deterministic only; these modules
    -- are not yet wired into Pipeline.
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          ReadingsDiscourseSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

test-suite nl2proof-intensional-test
    -- Ty2 intensional types for attitude reports: that-clauses as s->t
    -- propositions, reported (not asserted) content, factive presupposition,
    -- opacity on a finite model, and the reported-claim guard. Both parsers.
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          IntensionalSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

test-suite nl2proof-assertion-test
    -- Only the top-level conditions of the main box are asserted: nothing
    -- under negation, conditionals, disjunction, universals or a negated
    -- attitude enters the claim table, and none of it can reach an oracle.
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          AssertionSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable nl2proof-explain
    -- Study/debugging view of one sentence (or a short text): tokens and
    -- supertags, the derivation with every rule and category, lambda terms and
    -- types, the DRS, and the claim split, side by side. No arguments: a REPL
    -- that loads the CCGbank model once. Reads $CCGBANK_DIR (not in the repo).
    import:           warnings
    hs-source-dirs:   tools
    main-is:          Explain.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

test-suite semantic-repair
    -- Regression checks for real-text meaning repairs; miniature lexicons keep
    -- the gate independent of licensed data. Optional --corpus probes use CCGbank.
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          SemanticRepairSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

-- Exact support algebra and capability-backed graph regression properties.
test-suite strength-spec
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          StrengthSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

-- One model load for gold-free, scoped JSONL benchmark requests.
executable nl2proof-parse-json
    import:           warnings
    hs-source-dirs:   tools
    main-is:          ParseJSON.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof
    ghc-options:      -threaded -rtsopts

test-suite export
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          ExportSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

-- Structured source-withdrawal fixtures against the production evidence graph.
executable nl2proof-retraction-bench
    import:           warnings
    hs-source-dirs:   tools
    main-is:          RetractionBench.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

-- Independently scoped document witnesses must never alias during confirmation.
test-suite scope-oracle
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          ScopeOracleSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

-- Gold-free scoped meanings for independently authored construction fidelity tests.
executable nl2proof-fidelity-json
    import:           warnings
    hs-source-dirs:   test/fidelity
    main-is:          Export.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

-- POS-licensed proper names must retain rigid meanings across N and NP tags.
test-suite name-sem
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          NameSemSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

-- Closed determiners preserve existential/universal and negative scope.
test-suite quantifier-sem
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          QuantifierProposalSpec.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

-- A licensed irregular verb preserves names and nonverbal lexical categories.
test-suite has-lemma
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          HasLemmaProposalSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

-- A conditional delimiter cannot assert a second copy of the consequent.
test-suite conditional-boundary
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          ConditionalDuplicationSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

-- Local object reflexives share their lexical transitive subject referent.
test-suite reflexive-local
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          ReflexiveProposalSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

-- Composition retains both ends of a matched whole-category modifier.
test-suite composition-features
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          CompositionFeatureSpec.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof
