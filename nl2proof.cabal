cabal-version:      2.4
name:               nl2proof
version:            0.1.0.0
synopsis:           Text to oracle-verifiable logical form, for an RL reward signal
description:
  A substrate that turns natural language into discrete logical claims which an
  external domain oracle can confirm or refute, so the result is usable as a
  reinforcement-learning reward signal. See ARCHITECTURE.md.
  .
  Four stages: extract a candidate space, verify against an external oracle
  while retaining every derivation, fuse the confirmed claims, and score. Truth
  enters only at the oracle; nothing internal to the system is treated as
  evidence.
  .
  Dependencies are limited to what a bare GHC bindist ships with, so the
  project builds with plain @ghc --make@ and needs no package manager.
  See scripts/ for the no-cabal build path.

license:            NONE
author:             jmuslu
maintainer:         muslu.jo@northeastern.edu
category:           Language
build-type:         Simple
extra-doc-files:    README.md
                    ARCHITECTURE.md

common warnings
    ghc-options: -Wall -Wcompat -Wincomplete-record-updates
                 -Wincomplete-uni-patterns -Wredundant-constraints

library
    import:           warnings
    hs-source-dirs:   src
    default-language: Haskell2010
    exposed-modules:  NL2Proof.Provenance
                      NL2Proof.Trace
                      NL2Proof.Semantics.Lambda
                      NL2Proof.Syntax.Category
                      NL2Proof.Syntax.Lexicon
                      NL2Proof.Syntax.Tokenize
                      NL2Proof.Syntax.CCG
                      NL2Proof.Syntax.CCGBank
                      NL2Proof.Syntax.CCGRules
                      NL2Proof.Syntax.CCGDeriv
                      NL2Proof.Syntax.CCGTypeChange
                      NL2Proof.Syntax.CCGParse
                      NL2Proof.Syntax.CCGSupertag
                      NL2Proof.Syntax.CCGLexicon
                      NL2Proof.DRT.Types
                      NL2Proof.DRT.Build
                      NL2Proof.DRT.Canonical
                      NL2Proof.Collapse.Class
                      NL2Proof.Fragment
                      NL2Proof.Pipeline
                      NL2Proof.Stage2.Distribution
                      NL2Proof.Stage2.Modifier
                      NL2Proof.Stage2.Model
                      NL2Proof.Stage2.Alternatives
                      NL2Proof.Stage2.Fingerprint
                      NL2Proof.Stage2.RSA
                      NL2Proof.Stage2.SDRT
                      NL2Proof.Stage2.Threading
                      NL2Proof.Stage2.Pipeline
                      NL2Proof.Verify.Oracle
                      NL2Proof.Verify.Claims
                      NL2Proof.Genealogy
                      NL2Proof.Fusion
                      NL2Proof.Reward
    build-depends:    base       >=4.14 && <5
                    , containers >=0.6  && <0.8

executable nl2proof-demo
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccgbank-report
    -- Runs the verified CCGbank category classifier over the real extracted
    -- lexicon (LEX/*.lexicon) and reports the representability split. A research
    -- driver, not part of the library or its test suites.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGBankReport.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccg-grammar-coverage
    -- Measures the combinatory rule set (CCGRules) against CCGbank's GRAMMAR
    -- file of attested parent-->children rule instances. External check on the
    -- rules and the feature-unification policy. Research driver.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGGrammarCoverage.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccg-reconstruct
    -- Runs the rule set over real .auto derivations and reports how many whole
    -- sentences reconstruct. Sentence-granularity external check behind Layer 2's
    -- test-case generator. Research driver; reads .auto paths from argv.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGReconstruct.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccg-lexicon-ingest
    -- Ingests the real CCGbank lexicon into provenance-tagged entries and reports
    -- the representable/unrepresentable/unparseable split, asserting every built
    -- skeleton is well-typed. Research driver.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGLexiconIngest.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccg-typechange-coverage
    -- Train/test measurement of the type-changing rule class: induce from train
    -- .auto files, measure held-out coverage on test files. Guards against
    -- corpus-memorisation by reporting generalisation, not in-sample fit.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGTypeChangeCoverage.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccg-parse-coverage
    -- Whole-sentence bottom-up parse coverage: folds combinators + the learned
    -- type-change inventory into one CKY parse and measures, on held-out test
    -- sentences given gold supertags, how often the grammar derives the gold root.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGParseCoverage.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

executable ccg-supertag-parse
    -- From-words parsing: a frequency supertagger (trained on the train split)
    -- offers each word its top-k categories, the chart combines them. Reports OOV,
    -- oracle inclusion@k (the ceiling), and from-words parse-to-gold-root coverage.
    import:           warnings
    hs-source-dirs:   tools
    main-is:          CCGSupertagParse.hs
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

test-suite nl2proof-test
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

test-suite nl2proof-substrate-test
    -- Verification, genealogy, fusion and reward. Separate suite because these
    -- assert the design constraints (truth enters only at the oracle; a claim
    -- cannot ground itself) rather than the behaviour of the language front end.
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          SubstrateSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

test-suite nl2proof-stage2-test
    -- Stage 2 keeps its own suite so Stage 1's check count stays a stable
    -- number that means the same thing over time.
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Stage2Spec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof

test-suite nl2proof-ccgbank-test
    -- Parser and representability classifier for CCGbank's feature-annotated
    -- categories. Own suite so its check count is a stable, separate number
    -- from the Stage 1 language front end.
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          CCGBankSpec.hs
    other-modules:    Harness
    default-language: Haskell2010
    build-depends:    base, containers, nl2proof
