-- Build against no remote package repository.
--
-- This is not a workaround bolted on; it is the project's dependency-free
-- constraint made *enforceable*. Stage 1 uses only `base` and `containers`,
-- both of which ship inside every GHC installation, so the solver never needs
-- Hackage. If someone later adds a Hackage dependency, the build fails loudly
-- here rather than the project quietly acquiring one.
--
-- It also sidesteps a real problem on Ubuntu 24.04: the distro's cabal 3.8.1
-- ships stale Hackage TUF root keys, so `cabal update` fails with
--
--   <repo>/root.json does not have enough signatures signed with the
--   appropriate keys
--
-- With no active repository there is no index to verify, so the build works
-- offline and out of the box. See README.md for the one-time config note if
-- your cabal still complains.
packages: .
active-repositories: none
